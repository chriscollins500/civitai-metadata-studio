{
  "name": "civitai-metadata-studio",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local-first, single-file Civitai generation metadata inspector and editor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chriscollins500/civitai-metadata-studio.git"
  },
  "bugs": {
    "url": "https://github.com/chriscollins500/civitai-metadata-studio/issues"
  },
  "homepage": "https://chriscollins500.github.io/civitai-metadata-studio/",
  "keywords": [
    "civitai",
    "comfyui",
    "image-metadata",
    "stable-diffusion"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/package-release.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "verify": "node scripts/build.mjs && node scripts/package-release.mjs && node scripts/verify-build.mjs && node scripts/verify-release.mjs",
    "check": "node scripts/check.mjs",
    "docs:check": "node scripts/check-wiki.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/check-site.mjs",
    "test:site": "node --test site/tests/*.test.mjs",
    "brand:render": "node scripts/render-social-preview.mjs",
    "api": "node --use-system-ca automation/http.mjs",
    "mcp": "node --use-system-ca automation/mcp.mjs",
    "sdk:patch": "node scripts/patch-mcp-sdk.mjs",
    "sdk:check": "node scripts/verify-mcp-sdk.mjs",
    "sdk:repack": "node --use-system-ca scripts/repack-mcp-sdk.mjs",
    "test:automation": "npm --prefix automation test",
    "test:browser": "npm --prefix automation run test:browser",
    "ci": "npm run check && npm run docs:check && npm test && npm run test:automation && npm run verify && npm run test:site && npm run site:build && npm run site:check",
    "regression": "node --use-system-ca scripts/full-regression.mjs",
    "regression:civitai": "node --use-system-ca scripts/civitai-fixture-regression.mjs",
    "regression:sidecars": "node scripts/paired-sidecar-regression.mjs",
    "regression:public-images": "node --use-system-ca scripts/civitai-public-image-regression.mjs",
    "regression:model-families": "node --use-system-ca scripts/civitai-model-family-regression.mjs",
    "discover:civitai-users": "node --use-system-ca scripts/civitai-user-workflow-discovery.mjs",
    "audit:civitai-contract": "node --use-system-ca scripts/audit-civitai-contract.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
